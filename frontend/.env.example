# Origin of the FastAPI backend. Leave empty when using the Vite dev proxy.
VITE_API_BASE=
# Target used by the Vite dev/preview proxy. Not exposed to the browser bundle.
VITE_BACKEND_URL=http://127.0.0.1:8001
# Set to true to render the supplier-delay path from bundled fixtures
# instead of calling the API. Filtered duration requests are rejected.
VITE_USE_MOCK=false
# Local server ports (not exposed to the browser bundle).
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173
